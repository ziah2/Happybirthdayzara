# Copy to .env and fill in with your Supabase project values.
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional display name
VITE_APP_NAME=OAUSTECH Student Hub

# ----------------------------------------------------------------------------
# Server-side only (NOT exposed to the browser). Used by the notify-email
# edge function for transactional email via Resend. Set with:
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM="Student Hub <no-reply@yourdomain>"
# RESEND_API_KEY=
# EMAIL_FROM=
# ----------------------------------------------------------------------------
